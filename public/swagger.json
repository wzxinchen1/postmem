{
  "openapi": "3.0.0",
  "info": {
    "title": "PostMem API",
    "description": "个人知识库系统 API - 支持本地嵌入向量和智能文本切割",
    "version": "1.0.0",
    "contact": {
      "name": "PostMem"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "开发服务器"
    }
  ],
  "paths": {
    "/api/kb/ingest": {
      "post": {
        "summary": "知识入库",
        "description": "接受文本内容，智能切割后生成嵌入向量并存入数据库",
        "tags": ["Knowledge Base"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              },
              "example": {
                "kbName": "my-project",
                "content": "这是一段需要入库的文本内容..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "入库成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "模型服务不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/kb/search": {
      "post": {
        "summary": "语义检索",
        "description": "根据查询语句检索语义最相关的文本片段",
        "tags": ["Knowledge Base"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              },
              "example": {
                "kbName": "my-project",
                "query": "如何使用向量检索",
                "top_k": 5,
                "context_window": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "检索成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/kb/list": {
      "post": {
        "summary": "列表浏览",
        "description": "分页列出指定知识库下的所有片段",
        "tags": ["Knowledge Base"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListRequest"
              },
              "example": {
                "kbName": "my-project",
                "page": 1,
                "limit": 20
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "列表获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/kb/delete": {
      "post": {
        "summary": "单条删除",
        "description": "根据 ID 删除指定的片段",
        "tags": ["Knowledge Base"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteRequest"
              },
              "example": {
                "id": 123
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            }
          },
          "404": {
            "description": "片段不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/kb/stats": {
      "post": {
        "summary": "统计概览",
        "description": "查看知识库或所有知识库的统计信息",
        "tags": ["Knowledge Base"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatsRequest"
              },
              "examples": {
                "single_project": {
                  "value": {
                    "kbName": "my-project"
                  }
                },
                "all_projects": {
                  "value": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统计信息",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/StatsResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AllStatsResponse"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "知识库不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IngestRequest": {
        "type": "object",
        "required": ["kbName", "content"],
        "properties": {
          "kbName": {
            "type": "string",
            "description": "知识库名",
            "maxLength": 100
          },
          "content": {
            "type": "string",
            "description": "文本内容（最大 20000 字符）",
            "maxLength": 20000
          }
        }
      },
      "IngestResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "description": "切割后的片段数量"
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "description": "创建的片段 ID 列表"
              }
            }
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": ["kbName", "query"],
        "properties": {
          "kbName": {
            "type": "string",
            "description": "知识库名"
          },
          "query": {
            "type": "string",
            "description": "查询语句"
          },
          "top_k": {
            "type": "integer",
            "description": "返回结果数量",
            "default": 5,
            "minimum": 1,
            "maximum": 100
          },
          "context_window": {
            "type": "integer",
            "description": "上下文窗口大小（返回前后相邻片段）",
            "default": 1,
            "minimum": 0,
            "maximum": 5
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "description": "相似度分数（0-1）"
          },
          "chunkIndex": {
            "type": "integer",
            "description": "片段索引"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "cutModel": {
                "type": "string"
              },
              "chunkSize": {
                "type": "integer"
              },
              "originalLength": {
                "type": "integer"
              }
            }
          },
          "context": {
            "type": "object",
            "properties": {
              "prev": {
                "type": "string",
                "description": "前一个片段内容"
              },
              "next": {
                "type": "string",
                "description": "后一个片段内容"
              }
            }
          }
        }
      },
      "ListRequest": {
        "type": "object",
        "required": ["kbName"],
        "properties": {
          "kbName": {
            "type": "string",
            "description": "知识库名"
          },
          "page": {
            "type": "integer",
            "description": "页码",
            "default": 1,
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "description": "每页数量",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "ListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ListItem"
                }
              },
              "total": {
                "type": "integer"
              },
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "content": {
            "type": "string",
            "description": "内容摘要（前 200 字符）"
          },
          "chunkIndex": {
            "type": "integer"
          },
          "metadata": {
            "type": "object"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "片段 ID"
          }
        }
      },
      "DeleteResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "deleted": {
                "type": "boolean"
              },
              "id": {
                "type": "integer"
              }
            }
          }
        }
      },
      "StatsRequest": {
        "type": "object",
        "properties": {
          "kbName": {
            "type": "string",
            "description": "知识库名（可选，不提供则返回所有知识库统计）"
          }
        }
      },
      "StatsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "kbName": {
                "type": "string"
              },
              "total": {
                "type": "integer"
              },
              "lastUpdated": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "AllStatsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "projects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kbName": {
                      "type": "string"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "lastUpdated": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "PROJECT_NOT_FOUND",
                  "MEMORY_NOT_FOUND",
                  "EMBEDDING_ERROR",
                  "CUT_MODEL_ERROR",
                  "DATABASE_ERROR",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Knowledge Base",
      "description": "知识库管理接口"
    }
  ]
}
