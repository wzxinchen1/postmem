{
  "name": "postmem",
  "type": "module",
  "version": "1.0.0",
  "description": "Personal knowledge base system with local embedding and configurable LLM chunking",
  "private": true,
  "scripts": {
    "predev": "prisma generate && prisma migrate deploy && prisma db seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "pnpm tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "pnpm tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@langchain/anthropic": "^0.3.17",
    "@langchain/core": "^1.1.46",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "antd": "^6.3.7",
    "awilix": "^10.0.2",
    "axios": "^1.16.1",
    "dotenv": "^16.6.1",
    "langchain": "^1.4.0",
    "next": "^14.2.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swagger-ui-react": "^5.18.2",
    "typescript": "^5.6.3",
    "vm2": "^3.9.19",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/swagger-ui-react": "^4.18.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.20",
    "prisma": "^7.8.0",
    "sass": "^1.99.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
