{
  "name": "postmem-sdk",
  "version": "1.0.0",
  "description": "PostMem client SDK - chat with Redis Stream consumption",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "ioredis": "^5.6.0"
  },
  "peerDependencies": {},
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "keywords": [
    "postmem",
    "sdk",
    "chat",
    "redis-stream"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
