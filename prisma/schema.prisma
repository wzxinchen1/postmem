// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memory {
  id             Int                    @id @default(autoincrement())
  kbName         String                 @map("kb_name") @db.VarChar(100)
  content        String                 @db.Text
  embedding      Unsupported("vector(1024)")?
  chunkIndex     Int                    @map("chunk_index")
  metadata       Json                   @default("{}")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz()

  @@index([kbName])
  @@index([createdAt])
  @@map("memories")
}

// 提供商表
model Provider {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  type        String    @db.VarChar(50) // openai, anthropic, local, custom
  apiKey      String?   @map("api_key") @db.Text
  baseUrl     String?   @map("base_url") @db.VarChar(255)
  config      Json      @default("{}")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  models      Model[]

  @@index([type])
  @@index([isActive])
  @@map("providers")
}

// 模型表
model Model {
  id           Int       @id @default(autoincrement())
  providerId   Int       @map("provider_id")
  name         String    @db.VarChar(100)
  displayName  String?   @map("display_name") @db.VarChar(150)
  modelType    String    @map("model_type") @db.VarChar(50) // embedding, chat
  config       Json      @default("{}")
  isActive     Boolean   @default(true) @map("is_active")
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  provider     Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, name])
  @@index([modelType])
  @@index([isActive])
  @@index([isDefault])
  @@map("models")
}

// 知识库元数据表
model KnowledgeBase {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([name])
  @@map("knowledge_bases")
}

// 应用设置表
model Setting {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(100)
  value       Json
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("settings")
}

// 会话表 - 记录大模型调用会话
model Session {
  id          Int            @id @default(autoincrement())
  kbName      String?        @map("kb_name") @db.VarChar(100)
  modelType   String         @map("model_type") @db.VarChar(50) // embedding, chat
  modelName   String         @map("model_name") @db.VarChar(100)
  provider    String         @db.VarChar(100)
  status      String         @default("completed") @db.VarChar(20) // pending, completed, failed
  error       String?        @db.Text
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  messages    SessionMessage[]

  @@index([kbName])
  @@index([modelType])
  @@index([createdAt])
  @@index([status])
  @@map("sessions")
}

// 会话消息表 - 记录每次请求和响应
model SessionMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  role      String   @db.VarChar(20) // system, user, assistant
  content   String   @db.Text
  tokens    Int?     @default(0)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("session_messages")
}

