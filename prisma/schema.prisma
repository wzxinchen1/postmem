generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Topic {
  id          String        @id @default(cuid())
  kbId        String        @map("kb_id")
  name        String        @db.VarChar(200)
  description String        @db.VarChar(500)

  kb       KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  memories Memory[]

  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([kbId])
  @@unique([kbId, name])
  @@map("topics")
}

model Memory {
  id              String                 @id @default(cuid())
  kbId            String                 @map("kb_id")
  topicId         String?                @map("topic_id")
  title           String                 @db.VarChar(200)
  content         String
  embedding       Unsupported("vector(1024)")?
  metadata        Json                    @default("{}")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  knowledgeBase   KnowledgeBase           @relation(fields: [kbId], references: [id], onDelete: Cascade)
  topic           Topic?                  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([kbId])
  @@index([createdAt])
  @@index([topicId])
  @@map("memories")
}

model Vendor {
  id               String             @id @default(cuid())
  name             String             @unique @db.VarChar(100)
  url              String             @db.VarChar(255)
  chatModelClass   String?            @map("chat_model_class") @db.VarChar(100)
  embeddingModelClass String?          @map("embedding_model_class") @db.VarChar(100)
  factoryCode      String?            @map("factory_code")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider_options provider_options[]
  providers        Provider[]

  @@index([isActive])
  @@map("vendors")
}

model Provider {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  apiKey    String?  @map("api_key")
  baseUrl   String   @map("base_url") @db.VarChar(255)
  config    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  vendorId  String   @map("vendor_id")
  models    Model[]
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([vendorId])
  @@map("providers")
}

model Model {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  name        String   @db.VarChar(100)
  displayName String?  @map("display_name") @db.VarChar(150)
  modelType   String   @map("model_type") @db.VarChar(50)
  config      Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, name])
  @@index([modelType])
  @@index([isActive])
  @@index([isDefault])
  @@map("models")
}

model KnowledgeBase {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  memories      Memory[]
  topics        Topic[]
  sessions      Session[]

  @@index([name])
  @@map("knowledge_bases")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model Conversation {
  id        String        @id @default(cuid())
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages  ChatMessage[]

  @@index([createdAt])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           String       @db.VarChar(20)
  content        String
  tokens         Int          @default(0)
  totalTokens    Int          @default(0) @map("total_tokens")
  memoried       Boolean      @default(false)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("chat_messages")
}

model WebPage {
  id        String   @id @default(cuid())
  url       String   @unique
  title     String?  @db.Text
  content   String   @db.Text
  keywords  String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("web_pages")
}

model ChatSetting {
  id                      String   @id @default(cuid())
  memoryContextThreshold  Int      @default(50) @map("memory_context_threshold")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("chat_settings")
}

model Session {
  id            String           @id @default(cuid())
  kbId          String?          @map("kb_id")
  modelType     String           @map("model_type") @db.VarChar(50)
  modelName     String           @map("model_name") @db.VarChar(100)
  provider      String           @db.VarChar(100)
  status        String           @default("pending") @db.VarChar(20)
  error         String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  messages      SessionMessage[]
  knowledgeBase KnowledgeBase?   @relation(fields: [kbId], references: [id])

  @@index([kbId])
  @@index([modelType])
  @@index([createdAt])
  @@index([status])
  @@map("sessions")
}

model SessionMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  role      String   @db.VarChar(20)
  content   String
  tokens    Int      @default(0)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("session_messages")
}

model provider_options {
  id         String   @id @default(cuid())
  name       String   @unique @db.VarChar(100)
  vendor_id  String
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  vendors    Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([is_active])
  @@index([sort_order])
}
